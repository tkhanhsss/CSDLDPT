    "input": "content",
    "lowercase": false,
    "max_df": 0.6,
    "max_features": null,
    "min_df": 3,
    "ngram_range": [
      1,
      1
    ],
    "norm": "l2",
    "preprocessor": null,
    "smooth_idf": true,
    "stop_words": null,
    "strip_accents": null,
    "sublinear_tf": true,
    "token_pattern": null,
    "tokenizer": "gd1_stats.content_tokens",
    "use_idf": true,
    "vocabulary": null
  },
  "query": {
    "fit_on_corpus_only": true,
    "ranking": "cosine / dot product after L2",
    "top_k": 3,
    "label_or_metadata_used_in_score": false
  },
  "reference_gd1_versions": {
    "python": "3.10.11",
    "numpy": "2.2.6",
    "pandas": "2.3.3",
    "matplotlib": "3.10.9",
    "scikit_learn": "1.7.2",
    "scipy": "1.15.3",
    "nltk": "3.10.3"
  },
  "capture_versions": {
    "python": "3.10.11",
    "numpy": "2.2.6",
    "pandas": "2.3.3",
    "matplotlib": "3.10.9",
    "scikit_learn": "1.7.2",
    "scipy": "1.15.3",
    "nltk": "3.10.3"
  },
