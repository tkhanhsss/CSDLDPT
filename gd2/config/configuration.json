    "lowercase": true,
    "token_base": "token.split(\"'\")[0]",
    "min_base_length": 2,
    "filter_before_stemming": true,
    "stemmer": "nltk.stem.PorterStemmer",
    "stemmer_mode": "NLTK_EXTENSIONS",
